struct Byte { value: u8 }
struct ResultLanes { words: [m31; 4] }

fn step(v: [m31; 4]) -> [m31; 4] {
    v .* v + splat<4>(13_m31)
}

circuit public_u8_mixed_rejected(public x: Byte) -> public ResultLanes {
    let limb = std::int::limbs(x.value);
    let field = std::field::from_u16(limb);
    let pair = std::array::concat(field, field);
    let start = std::array::concat(pair, pair);
    ResultLanes { words: iterate<16>(step, start) }
}
