fn make(a: [m31; 4]) -> Fn([m31; 4]) -> [m31; 4] {
    let squared = a .* a;
    fun(v: [m31; 4]) -> [m31; 4] => squared + v
}

fn double(a: [m31; 4]) -> [m31; 4] {
    a + a
}

fn identity(f: Fn([m31; 4]) -> [m31; 4]) -> Fn([m31; 4]) -> [m31; 4] {
    f
}

circuit nested4(public x: [m31; 4]) -> public [m31; 4] {
    let result = (identity(make(x)))(double(x));
    result
}
