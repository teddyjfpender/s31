use std@1;

fn horner_step(x: [m31; 4]) -> Fn([m31; 4], [m31; 4]) -> [m31; 4] {
    fun(acc: [m31; 4], coeff: [m31; 4]) -> [m31; 4] => acc .* x + coeff
}

circuit horner(private x: [m31; 4], private a: [m31; 4],
    private b: [m31; 4], private c: [m31; 4]) -> public [m31; 4] {
    let step = horner_step(x);
    let out = std::array::fold(step, a, [b, c]);
    out
}
