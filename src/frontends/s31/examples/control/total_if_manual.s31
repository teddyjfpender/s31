use std@1;

// First-order strict-selector reference for total_if.s31.
circuit total_if(public choice: bit, private x: [m31; 1], public y: [m31; 1])
    -> public [m31; 1] {
    let on_true = x .* x;
    let on_false = y + splat<1>(1_m31);
    let result = select(choice, on_false, on_true);
    result
}
