// One square with nonzero affine maps on both sides shares the step chip.
use std@1;

fn step(v: [m31; 4]) -> [m31; 4] {
    let before = v .* splat<4>(3_m31) + splat<4>(5_m31);
    let squared = before .* before;
    squared .* splat<4>(7_m31) + splat<4>(11_m31)
}

circuit private_affine_square16(private secret: [m31; 4]) -> public [m31; 1] {
    let state = iterate<16>(step, secret);
    let total = std::math::sum_lanes(state);
    total
}
