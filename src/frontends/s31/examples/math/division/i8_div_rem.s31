use std@1;

// Signed division truncates toward zero: -7 = (-2)*3 + (-1).
circuit i8_div_rem(private numerator: i8, private divisor: i8) -> public [u16; 2] {
    let (quotient, remainder) = std::int::div_rem(numerator, divisor);
    let result = std::array::concat(std::int::limbs(quotient), std::int::limbs(remainder));
    result
}
