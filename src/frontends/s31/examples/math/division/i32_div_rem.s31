use std@1;

// Signed division truncates toward zero and keeps the remainder's sign.
circuit i32_div_rem(private numerator: i32, private divisor: i32) -> public [u16; 4] {
    let (quotient, remainder) = std::int::div_rem(numerator, divisor);
    let result = std::array::concat(std::int::limbs(quotient), std::int::limbs(remainder));
    result
}
