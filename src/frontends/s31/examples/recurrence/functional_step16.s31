use std@1;

fn step(v: [m31; 4]) -> [m31; 4] {
    v .* v + splat<4>(7_m31)
}

fn apply(f: Fn([m31; 4]) -> [m31; 4], x: [m31; 4]) -> [m31; 4] {
    f(x)
}

circuit functional_step16(public x: [m31; 4]) -> public [m31; 4] {
    let run = fun(initial: [m31; 4]) -> [m31; 4] => iterate<16>(step, initial);
    let result = apply(run, x);
    result
}
